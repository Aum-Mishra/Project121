# Coding Agent backend — isolated service (port 8002).
# The workbench passes these values to the spawned service, so it always runs
# in the same deployment mode as the main app.

APP_MODE=local

# Local mode (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
CODING_MODEL=qwen2.5-coder:7b

# Cloud mode (Nebius Token Factory — NVIDIA Nemotron, OpenAI-compatible)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_CODER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_TIMEOUT_S=600

# Execution policy
SANDBOX_TIMEOUT_S=120
MAX_COMMAND_TIMEOUT_S=300
ALLOW_NETWORK=false
MAX_REPAIR_ATTEMPTS=3
OPENHANDS_ENABLED=true
OPENHANDS_TIMEOUT_S=240

# Storage (empty = defaults under coding_agent/data)
DATABASE_URL=
CODING_ROOT=
