# ── Deployment mode ─────────────────────────────────────────────────────────
# local  -> all AI features use the local Ollama server (installed models)
# cloud  -> all AI features use NVIDIA Nemotron via the Nebius Token Factory
#           OpenAI-compatible API. No Ollama / local-model fallback in cloud mode.
APP_MODE=local
# Backward-compatible alias (APP_MODE wins when both are set).
# LLM_MODE=local

# ── Local mode (Ollama) ─────────────────────────────────────────────────────
LOCAL_API_BASE=http://localhost:11434
LOCAL_ROUTER_MODEL=qwen2.5:3b
LOCAL_REASONING_MODEL=qwen2.5:7b
LOCAL_CODER_MODEL=qwen2.5-coder:7b
LOCAL_EMBEDDING_MODEL=bge-m3:latest

# ── Cloud mode (Nebius Token Factory — NVIDIA Nemotron) ─────────────────────
# Server-side only: never expose this key to the browser.
NEBIUS_API_KEY=
# OpenAI-compatible base URL (NEBIUS_ENDPOINT is accepted as an alias).
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_ROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_CODER_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional. Leave empty to use deterministic lexical retrieval in cloud mode
# (no local embeddings are ever used in cloud mode).
NEBIUS_EMBEDDING_MODEL=
# Enabling remote vector indexing is opt-in because it embeds the whole corpus
# through the Nebius API (slow + billable). Lexical retrieval works without it.
CLOUD_AUTO_INGEST=0
NEBIUS_TIMEOUT=600

# ── Legacy / storage ────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/text-embedding-004
DATABASE_URL=sqlite:///./knovia.db
VECTOR_DB_PATH=./backend/storage/qdrant
VECTOR_DB_URL=http://localhost:6333
VECTOR_COLLECTION=mrpl_knowledge
DOCUMENT_STORAGE_PATH=./backend/storage/documents
ARTIFACT_STORAGE_PATH=./backend/storage/artifacts
